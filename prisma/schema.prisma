generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PointMovementType {
  PURCHASE
  REFERRAL
  ADJUSTMENT
  REDEMPTION
  REVERSAL
}

enum ServiceRequestStatus {
  PENDING
  CONTACTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalonServiceMode {
  QUOTE
  RESERVE
}

model User {
  id                   String          @id @default(uuid())
  customerCode         String          @unique
  name                 String
  email                String          @unique
  phone                String
  active               Boolean         @default(true)
  sessionVersion       Int             @default(1)
  passwordHash         String
  role                 UserRole        @default(CUSTOMER)
  purchasePoints       Int             @default(0)
  referralPoints       Int             @default(0)
  referralCount        Int             @default(0)
  referredById         String?
  referredBy           User?           @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers        User[]          @relation("UserReferrals")
  referralCodes        ReferralCode[]  @relation("CodeOwner")
  redeemedReferralCode ReferralCode?   @relation("CodeRedeemer")
  appointments         Appointment[]
  shopOrders           ShopOrder[]
  pointMovements       PointMovement[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([createdAt])
}

model StaffAccount {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  sessionVersion Int             @default(1)
  active         Boolean         @default(true)
  pointMovements PointMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([active])
}

model ReferralCode {
  id         String   @id @default(uuid())
  code       String   @unique
  ownerId    String
  owner      User     @relation("CodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  usedById   String?  @unique
  usedBy     User?    @relation("CodeRedeemer", fields: [usedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([ownerId, expiresAt])
}

model PointMovement {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             PointMovementType
  points           Int
  amountColones    Int?
  description      String
  referenceId      String?           @unique
  invoiceNumber    String?           @unique
  createdByStaffId String?
  createdByStaff   StaffAccount?     @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([createdByStaffId, createdAt])
}

model ServiceRequest {
  id            String               @id @default(uuid())
  name          String
  phone         String
  service       String
  details       String
  preferredDate DateTime?
  preferredTime String?
  status        ServiceRequestStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, createdAt])
}

model ProductCategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id          String          @id @default(uuid())
  slug        String          @unique
  sku         String?         @unique
  name        String
  brand       String
  description String
  price       Int
  imageUrl    String
  stock       Int?
  available   Boolean         @default(true)
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId, active, available, sortOrder])
  @@index([brand])
  @@index([name])
}

model ServiceCategory {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  eyebrow     String
  description String
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  services    SalonService[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, sortOrder])
}

model SalonService {
  id              String            @id @default(uuid())
  slug            String            @unique
  name            String
  description     String?
  mode            SalonServiceMode
  price           Int?
  durationMinutes Int?
  note            String?
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  categoryId      String
  category        ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId, active, sortOrder])
  @@index([mode, active])
}

model RateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model AgendaConfig {
  id Int @id @default(1)
  weekly Json @default("[]")
  overrides Json @default("[]")
  holdHours Int @default(24)
  noticeMinutes Int @default(120)
  updatedAt DateTime @updatedAt
}

model Appointment {
  id String @id @default(uuid())
  customerId String?
  customer User? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName String
  phone String
  startAt DateTime
  endAt DateTime
  status String @default("PENDING")
  expiresAt DateTime?
  services Json
  notes String @default("")
  requestKey String @unique
  requestDigest String
  responseMessage String @default("")
  proposedStartAt DateTime?
  proposedEndAt DateTime?
  proposalAppointmentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([startAt, endAt])
  @@index([customerId, startAt])
}

model ShopOrder {
  id String @id @default(uuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items Json
  total Int
  status String @default("PENDING")
  requestKey String @unique
  requestDigest String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, createdAt])
}

model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model EmailDelivery {
  id String @id @default(uuid())
  eventKey String @unique
  recipient String
  subject String
  text String
  html String
  attempts Int @default(0)
  sentAt DateTime?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([sentAt, nextAttemptAt])
}
