PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zenit?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000,https://zenitsalon.com,https://www.zenitsalon.com
# Only set to a verified number of trusted reverse proxies; never set to true.
TRUST_PROXY_HOPS=0
SUPPORT_EMAIL=systemlabcr@gmail.com
REFERRAL_REWARD_POINTS=100
REFERRAL_EXPIRY_HOURS=72
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# One-time owner provisioning; remove OWNER_PASSWORD after running owner:provision.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
OWNER_PASSWORD=
# Disabled unless a random secret of at least 32 characters is supplied.
# Must only be copied to the future POS backend, never NEXT_PUBLIC_* variables.
ZENIT_CONNECT_KEY=
STAFF_1_NAME=
STAFF_1_EMAIL=
STAFF_1_PASSWORD=
STAFF_2_NAME=
STAFF_2_EMAIL=
STAFF_2_PASSWORD=

# Reserva: destinataria de los avisos; si se omite, usa OWNER_EMAIL o los ADMIN activos.
BOOKING_OWNER_EMAIL=
BOOKING_SITE_URL=https://zenitsalon.com
# Opcional: enviar notificaciones de citas por HTTPS (preferencia si se configura).
# Remitente del dominio verificado en Resend; nunca una dirección Gmail arbitraria.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
